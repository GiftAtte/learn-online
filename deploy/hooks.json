[
  {
    "id": "learnonline",
    "execute-command": "/opt/learnonline/deploy/deploy.sh",
    "command-working-directory": "/opt/learnonline",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "HOOK_SECRET" | js }}",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/dev",
            "parameter": { "source": "payload", "name": "ref" }
          }
        }
      ]
    }
  }
]
