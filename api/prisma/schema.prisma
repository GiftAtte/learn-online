generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(LEARNER)
  // Bumped on sign-out: tokens issued before the bump stop working immediately.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments   Enrollment[]
  progress      LessonProgress[]
  tokens        UserToken[]
  refreshTokens RefreshToken[]
}

enum UserTokenType {
  RESET_PASSWORD
}

/// A single-use link token emailed to a person (password reset). Only a hash is stored, so a database leak is not a key.
model UserToken {
  id        String        @id @default(uuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
}

model Course {
  id           String   @id @default(uuid())
  title        String
  description  String
  categoryId   String
  thumbnailUrl String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Restrict: a category that still has courses cannot be deleted.
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([categoryId])
  @@index([published])
}

model Lesson {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  description     String
  videoUrl        String
  /// Picture shown for the lesson on the course page; optional.
  thumbnailUrl    String?
  durationSeconds Int
  order           Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id                  String    @id @default(uuid())
  userId              String
  lessonId            String
  lastPositionSeconds Int       @default(0)
  completed           Boolean   @default(false)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// Application details an administrator can change: one row, always id "app".
model AppSettings {
  id                String   @id @default("app")
  appName           String   @default("LearnOnline")
  tagline           String?
  logoUrl           String?
  supportEmail      String?
  /// Upload rules: biggest file in megabytes, and the file extensions allowed, per kind.
  imageMaxMegabytes Int      @default(10)
  videoMaxMegabytes Int      @default(100)
  imageFormats      String[] @default(["jpg", "jpeg", "png", "webp", "gif"])
  videoFormats      String[] @default(["mp4", "webm", "mov"])
  /// Whether new people can create their own account (administrators can still be promoted).
  allowSignups      Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// A long-lived sign-in that can only be used once: using it hands out a new one (rotation). Only a hash is
/// stored. Presenting one that was already used means it leaked, so every session of that person is ended.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
