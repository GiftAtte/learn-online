NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://learn:learn@localhost:5432/learnonline?schema=public"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
# Days a sign-in lasts without being used (refresh token).
REFRESH_TOKEN_DAYS=30
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none)
TRUST_PROXY=0
# Sign-up attempts per address per 15 minutes. Keep 20 in real use.
AUTH_RATE_LIMIT=20
# Requests of any kind per address per 15 minutes. Keep 600 in real use.
API_RATE_LIMIT=600
# Wrong passwords allowed per address before it is blocked, and how many minutes the block lasts.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Cloudinary stores uploaded lesson videos and cover images (https://cloudinary.com, the free plan is enough).
# Find the three values on the Cloudinary dashboard. Without them uploads are switched off and links still work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email (Mailtrap sandbox). Copy these from Mailtrap > Email Testing > Inboxes > SMTP Settings.
# Leave MAIL_USER empty and the verification / reset links are printed in the server log instead.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="LearnOnline <no-reply@learnonline.dev>"
EMAIL_TOKEN_MINUTES=60
